APP_ENV=production
PORT=3000

NOTION_API_KEY=secret_your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_database_uuid_here
NOTION_DATA_SOURCE_ID=
NOTION_VERSION=2026-03-11
NOTION_WEBHOOK_VERIFICATION_TOKEN=your_webhook_verification_token_here

# SEC-001: development-only opt-out of webhook signature verification.
# Leave unset (false) unless you are testing locally; production rejects it.
ALLOW_UNSIGNED_WEBHOOKS=false

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@direct-host/dbname?sslmode=require
TEST_DATABASE_URL=

# SEC-002: development-only opt-out of TLS certificate verification for
# self-signed local databases. Leave unset (false) for Neon and production.
DB_SSL_INSECURE=false

SYNC_TIMEZONE=Asia/Kolkata
# Recommended cadence for the EXTERNAL reconciliation scheduler (cron/systemd/
# Task Scheduler). The service has no in-process scheduler.
SYNC_RECONCILIATION_INTERVAL_MINUTES=30
SYNC_MAX_ATTEMPTS=8
SYNC_PAGE_SIZE=100
SYNC_SYNC_BODY_CONTENT=true
SYNC_LEASE_SECONDS=300
LOG_LEVEL=info
