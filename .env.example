# ---------------------------------------------------------------------------
# Copy to `.env` (git-ignored) and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Notion -----------------------------------------------------------------
# Integration token from https://www.notion.so/my-integrations (secret_… or ntn_…)
NOTION_API_KEY=
# Container database ID (32 hex chars, dashes optional)
NOTION_DATABASE_ID=
# Only needed when the database exposes more than one data source
NOTION_DATA_SOURCE_ID=
# Pinned API version; this service only supports 2026-03-11
NOTION_VERSION=2026-03-11
# Set after the one-time webhook verification handshake (required in production)
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# --- PostgreSQL (Neon) ------------------------------------------------------
# Pooled runtime connection string
DATABASE_URL=
# Direct (non-pooled) connection string used only by migrations
DIRECT_DATABASE_URL=

# --- Synchronization --------------------------------------------------------
SYNC_TIMEZONE=Asia/Kolkata
SYNC_RECONCILIATION_INTERVAL_MINUTES=30
SYNC_MAX_ATTEMPTS=8
SYNC_PAGE_SIZE=100
SYNC_SYNC_BODY_CONTENT=true
SYNC_LEASE_SECONDS=300
