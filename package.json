{
  "name": "notion-tasks-pg-sync",
  "version": "0.1.0",
  "private": true,
  "description": "One-way Notion Tasks -> PostgreSQL synchronization service",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "db:migrate": "tsx db/migrate.ts up",
    "db:status": "tsx db/migrate.ts status",
    "sync:backfill": "tsx scripts/backfill.ts",
    "sync:reconcile": "tsx scripts/reconcile.ts",
    "sync:worker": "tsx scripts/worker.ts",
    "sync:schedule": "tsx scripts/schedule.ts",
    "sync:retry-failed": "tsx scripts/retry-failed.ts",
    "sync:recover-stuck": "tsx scripts/recover-stuck.ts"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@notionhq/client": "^5.27.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  }
}
