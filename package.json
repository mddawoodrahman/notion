{
  "name": "notion-tasks-pg-sync",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "worker": "tsx --env-file-if-exists=.env scripts/sync-worker.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "db:migrate": "tsx --env-file-if-exists=.env db/migrate.ts",
    "sync:backfill": "tsx --env-file-if-exists=.env scripts/sync-backfill.ts",
    "sync:reconcile": "tsx --env-file-if-exists=.env scripts/sync-reconcile.ts",
    "sync:retry-failed": "tsx --env-file-if-exists=.env scripts/sync-retry-failed.ts",
    "sync:recover-stuck": "tsx --env-file-if-exists=.env scripts/sync-recover-stuck.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@notionhq/client": "^5.27.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
